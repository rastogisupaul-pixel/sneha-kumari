# Copy to .env and configure via environment secrets before starting backend
PORT=8080
GOOGLE_CLOUD_PROJECT=gen-lang-client-0079366378
FIRESTORE_DATABASE_ID=ai-studio-android-smile-b4208da4-0868-42d4-aa45-6439b6cf9b43

# Comma-separated origin allowlist for Admin Web Dashboard (never use *)
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8080

# Coturn ephemeral HMAC-SHA1 shared secret (matches static-auth-secret in turnserver.conf)
TURN_SHARED_SECRET=
TURN_REALM=turn.smilechat.example
TURN_HOST=turn.smilechat.example

# Optional comma-separated bootstrap admin emails (in addition to Firestore admins/{uid} docs)
BOOTSTRAP_ADMIN_EMAILS=

# Optional TOTP Base32 secret per admin environment for 2FA enforcement on sensitive admin mutations
ADMIN_TOTP_SECRET=
